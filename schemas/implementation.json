{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "checks", "blockers"],
  "properties": {
    "status": { "type": "string", "enum": ["done", "blocked"] },
    "summary": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed"],
        "properties": {
          "command": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
