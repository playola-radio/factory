{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "dispositions", "checks", "blockers"],
  "properties": {
    "summary": { "type": "string" },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "reason"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string", "enum": ["fixed", "declined"] },
          "reason": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed"],
        "properties": {
          "command": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
